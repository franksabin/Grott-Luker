{
  // Cloudflare Worker serving the built SPA plus the submissions API.
  //
  // Setup (one time):
  //   1. npx wrangler d1 create grott-luker-snapshots
  //      → paste the returned database_id below.
  //   2. npx wrangler d1 execute grott-luker-snapshots --remote --file=./schema.sql
  //   3. npx wrangler secret put CPA_PASSCODE
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grott-luker",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routed app: unknown paths return index.html.
    "not_found_handling": "single-page-application",
    // API paths must reach the Worker rather than the SPA fallback.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grott-luker-snapshots",
      "database_id": "5a4f2f58-eaf9-43c3-a0e5-b5fcf0afcfed"
    }
  ],

  "observability": {
    "enabled": true
  }
}
